COMPOSE_PROJECT_NAME=iot-portal
PRODUCTION_ENV_FILE=.env.production
APP_IMAGE=ghcr.io/owner/repository:latest

APP_NAME="LMU IoT Portal"
APP_ENV=production
APP_KEY=base64:replace-with-generated-key
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://iot.example.com
APP_DOMAIN=iot.example.com
TRUSTED_PROXIES=*
TRUSTED_HOSTS=^iot\.example\.com$

HTTP_PORT=80
HTTPS_PORT=443

FORGE_PROXY_BIND=127.0.0.1
FORGE_PROXY_PORT=18080

OCTANE_SERVER=frankenphp
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000
OCTANE_ADMIN_HOST=127.0.0.1
OCTANE_ADMIN_PORT=2019
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=500
OCTANE_HTTPS=true

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=lmu_iot_portal
DB_USERNAME=iot_portal
DB_PASSWORD=replace-with-strong-password

SESSION_DRIVER=redis
CACHE_STORE=redis
PULSE_CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_QUEUE_BLOCK_FOR=5
REDIS_QUEUE_RETRY_AFTER=90

NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=
NIGHTWATCH_SERVER=iot-portal-production
NIGHTWATCH_INGEST_URI=nightwatch:2407
NIGHTWATCH_REQUEST_SAMPLE_RATE=1.0
NIGHTWATCH_COMMAND_SAMPLE_RATE=1.0
NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0
NIGHTWATCH_SCHEDULED_TASK_SAMPLE_RATE=1.0
NIGHTWATCH_LOG_LEVEL=warning

PULSE_ENABLED=true
PULSE_INGEST_DRIVER=redis
PULSE_REDIS_CONNECTION=default
PULSE_SERVER_NAME=iot-portal-production
PULSE_SERVER_DIRECTORIES=/app:/app/storage
PULSE_SLOW_REQUESTS_THRESHOLD=1000
PULSE_SLOW_QUERIES_THRESHOLD=1000
PULSE_SLOW_JOBS_THRESHOLD=1000
PULSE_SLOW_OUTGOING_REQUESTS_THRESHOLD=1000

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=lmu-iot-portal
REVERB_APP_KEY=replace-with-public-reverb-key
REVERB_APP_SECRET=replace-with-private-reverb-secret
REVERB_HOST=iot.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_VERIFY_SSL=true
REVERB_BROADCAST_HOST=reverb
REVERB_BROADCAST_PORT=8090
REVERB_BROADCAST_SCHEME=http
REVERB_BROADCAST_VERIFY_SSL=false
REVERB_PUBLIC_HOST=iot.example.com
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8090
REVERB_SERVER_PATH=
REVERB_SCALING_ENABLED=false
VITE_REVERB_APP_KEY=replace-with-public-reverb-key
VITE_REVERB_HOST=iot.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_APP_NAME="${APP_NAME}"

IOT_INJECT_META_COMMAND_ID=true
IOT_COMMAND_TIMEOUT_SECONDS=120
IOT_NATS_HOST=nats
IOT_NATS_PORT=4222
IOT_NATS_TIMEOUT=5
IOT_NATS_HEALTH_CHECK_SECONDS=15
IOT_PRESENCE_SUBJECT_PREFIX=devices
IOT_PRESENCE_SUBJECT_SUFFIX=presence
IOT_HEARTBEAT_TIMEOUT_SECONDS=300
IOT_PRESENCE_WRITE_THROTTLE_SECONDS=15
IOT_MQTT_HOST=emqx
IOT_MQTT_PORT=1883
IOT_BROADCAST_RAW_TELEMETRY=false
IOT_MQTT_TLS_ENABLED=false
IOT_MQTT_TLS_CA_PATH=
IOT_MQTT_TLS_CLIENT_CERT_PATH=
IOT_MQTT_TLS_CLIENT_KEY_PATH=
IOT_MQTT_TLS_VERIFY_PEER=true
IOT_MQTT_TLS_VERIFY_PEER_NAME=true
IOT_MQTT_TLS_ALLOW_SELF_SIGNED=false

IOT_PKI_CA_CERT_PATH=
IOT_PKI_CA_KEY_PATH=
IOT_PKI_DEFAULT_VALIDITY_DAYS=365
IOT_PKI_SUBJECT_COUNTRY=US
IOT_PKI_SUBJECT_ORGANIZATION="${APP_NAME}"

INGESTION_PIPELINE_ENABLED=true
INGESTION_PIPELINE_DRIVER=go
TELEMETRY_INGESTER_IMAGE=
INGESTION_PIPELINE_BROADCAST_REALTIME=true
INGESTION_PIPELINE_BROADCAST_THROTTLE_SECONDS=5
INGESTION_PIPELINE_HOT_STATE_COALESCE_SECONDS=1
INGESTION_PIPELINE_PUBLISH_ANALYTICS=true
INGESTION_PIPELINE_PUBLISH_INVALID=true
INGESTION_PIPELINE_QUEUE_CONNECTION=redis
INGESTION_PIPELINE_QUEUE=ingestion
INGESTION_PIPELINE_SIDE_EFFECTS_QUEUE_CONNECTION=redis
INGESTION_PIPELINE_SIDE_EFFECTS_QUEUE=telemetry-side-effects
INGESTION_METADATA_TTL_SECONDS=300
INGESTION_REGISTRY_TTL_SECONDS=30
INGESTION_STAGE_LOG_MODE=failures
INGESTION_STAGE_LOG_SAMPLE_RATE=0.0
INGESTION_CAPTURE_STAGE_SNAPSHOTS=true
INGESTION_CAPTURE_SUCCESS_STAGE_SNAPSHOTS=false
INGESTION_DEFAULT_RAW_RETENTION_DAYS=90
INGESTION_TELEMETRY_CHUNK_INTERVAL="1 day"
INGESTION_TELEMETRY_COMPRESS_AFTER="7 days"
INGESTION_TELEMETRY_RETENTION="90 days"
INGESTION_MESSAGES_RETENTION_DAYS=14
INGESTION_STAGE_LOG_RETENTION_DAYS=7
INGESTION_STORAGE_PRUNE_BATCH_SIZE=1000
INGESTION_NATS_HOST=nats
INGESTION_NATS_PORT=4222
INGESTION_NATS_TIMEOUT=5
INGESTION_NATS_HEALTH_CHECK_SECONDS=15
INGESTION_NATS_SUBJECT='devices.*.telemetry,devices.*.*.telemetry,devices.*.*.*.telemetry,migration.source.imoni.*.*.telemetry,migration.source.egravity.*.telemetry'
INGESTION_NATS_ANALYTICS_PREFIX=iot.v1.analytics
INGESTION_NATS_INVALID_PREFIX=iot.v1.invalid
INGESTION_GO_INCOMING_SUBJECT=iot.v1.ingestion.incoming
INGESTION_GO_PERSISTED_SUBJECT=iot.v1.ingestion.persisted
INGESTION_SUBJECT_ENV=production
IOT_DEVICE_STATE_NATS_SUBJECT='devices.*.state,devices.*.*.state,devices.*.*.*.state'

AUTOMATION_PIPELINE_ENABLED=true
AUTOMATION_PIPELINE_TELEMETRY_FANOUT_ENABLED=true
AUTOMATION_PIPELINE_QUEUE_CONNECTION=redis
AUTOMATION_PIPELINE_QUEUE=automation
AUTOMATION_PIPELINE_TELEMETRY_DISPATCH_COOLDOWN_SECONDS=0
AUTOMATION_PIPELINE_LOG_CHANNEL=automation_pipeline
AUTOMATION_STEP_LOG_MODE=failures
AUTOMATION_STEP_LOG_SAMPLE_RATE=0.0
AUTOMATION_CAPTURE_STEP_SNAPSHOTS=false

REPORTING_STORAGE_DISK=local
REPORTING_STORAGE_DIRECTORY=reports
REPORTING_QUEUE_CONNECTION=redis
REPORTING_QUEUE=default
REPORTING_DEFAULT_MAX_RANGE_DAYS=31
REPORTING_API_BASE_URL=https://iot.example.com
REPORTING_API_TIMEOUT_SECONDS=30
REPORTING_INTERNAL_TOKEN=replace-with-internal-token
REPORTING_INTERNAL_TOKEN_HEADER=X-Reporting-Token

FILESYSTEM_DISK=local
FILAMENT_FILESYSTEM_DISK=public

REDIS_SIMULATIONS_QUEUE_CONNECTION=default
REDIS_SIMULATIONS_QUEUE=simulations
REDIS_SIMULATIONS_QUEUE_RETRY_AFTER=300
REDIS_SIMULATIONS_QUEUE_BLOCK_FOR=5

IOT_DASHBOARD_SNAPSHOT_CACHE_SECONDS=2
IOT_DASHBOARD_HOT_STATE_READS_ENABLED=false

HORIZON_DOMAIN=
HORIZON_PATH=horizon
HORIZON_PREFIX=
HORIZON_DEFAULT_PROCESSES=2
HORIZON_INGESTION_PROCESSES=1
HORIZON_SIDE_EFFECTS_PROCESSES=2
HORIZON_AUTOMATION_PROCESSES=2
HORIZON_SIMULATION_PROCESSES=1
HORIZON_AUTO_BALANCING_ENABLED=false
HORIZON_AUTO_SCALING_STRATEGY=time
HORIZON_AUTO_BALANCE_MAX_SHIFT=1
HORIZON_AUTO_BALANCE_COOLDOWN=3
HORIZON_DEFAULT_MAX_PROCESSES=2
HORIZON_INGESTION_MAX_PROCESSES=1
HORIZON_SIDE_EFFECTS_MAX_PROCESSES=2
HORIZON_AUTOMATION_MAX_PROCESSES=2
HORIZON_SIMULATION_MAX_PROCESSES=1

FORWARD_NATS_PORT=4222
FORWARD_NATS_MONITORING_PORT=8222
NATS_CLIENT_BIND=127.0.0.1
NATS_MONITORING_BIND=127.0.0.1
EMQX_IMAGE=emqx/emqx-enterprise:6.2.1
FORWARD_EMQX_MQTT_PORT=1883
FORWARD_EMQX_DASHBOARD_PORT=18083
EMQX_MQTT_BIND=127.0.0.1
EMQX_DASHBOARD_BIND=127.0.0.1
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=replace-with-strong-emqx-dashboard-password
NODE_RED_MQTT_USERNAME=node-red-migration
NODE_RED_MQTT_PASSWORD=replace-with-node-red-mqtt-password
IOT_DEVICE_MQTT_USERNAME=device-client
IOT_DEVICE_MQTT_PASSWORD=replace-with-device-mqtt-password
FORWARD_NODE_RED_PORT=1880
NODE_RED_BIND=127.0.0.1
NODE_RED_MQTT_BROKER_HOST=emqx
NODE_RED_MQTT_BROKER_PORT=1883

GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_IMAGE=grafana/grafana-oss:13.0.2
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
GRAFANA_ROOT_URL=http://localhost:3000
LOKI_IMAGE=grafana/loki:3.7.2
PROMETHEUS_IMAGE=prom/prometheus:v3.5.4
PROMETHEUS_RETENTION=15d
ALLOY_IMAGE=grafana/alloy:v1.17.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.11.1
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.55.1

BACKUP_S3_BUCKET=iot-portal-backups
BACKUP_S3_PREFIX=postgres
BACKUP_S3_ENDPOINT_URL=https://s3.example.com
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=replace-with-backup-access-key
BACKUP_S3_SECRET_ACCESS_KEY=replace-with-backup-secret-key

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
